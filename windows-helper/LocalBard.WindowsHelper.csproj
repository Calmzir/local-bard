<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LocalBard.WindowsHelper</AssemblyName>
    <RootNamespace>LocalBard.WindowsHelper</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Published as a self-contained single file so electron-builder can
         bundle a plain .exe via extraResources with no separately-installed
         .NET runtime dependency on the end user's machine. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
