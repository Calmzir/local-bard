# Local Bard - local development environment file.
#
# This file is for DEV CONVENIENCE ONLY (see src/main/index.ts) and is never
# read in a packaged/production build. Copy this to `.env` and fill it in;
# `.env` itself is git-ignored and must never be committed.
#
# In production (and if you'd rather not use this at all in dev) the bot
# token is entered once through the app's first-run GUI prompt and stored
# encrypted via Electron's safeStorage API -- this env var is purely a
# shortcut so you don't have to re-paste the token every time you run
# `npm run dev`.

# Discord bot token (from https://discord.com/developers/applications -> your app -> Bot).
# NEVER commit a real value here.
DISCORD_BOT_TOKEN=
